{
  "name": "@jabez007/load-tester-client",
  "version": "1.0.0",
  "description": "A cURL-like client to run load tests against a service",
  "type": "module",
  "bin": {
    "load-tester-client": "./dist/index.js"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "pretest": "npm run build",
    "test": "mocha",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "cURL",
    "Benchmark",
    "Load"
  ],
  "author": "Jimmy McCann",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jabez007/load-tester-client.git"
  },
  "bugs": {
    "url": "https://github.com/jabez007/load-tester-client/issues"
  },
  "homepage": "https://github.com/jabez007/load-tester-client#readme",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "yargs": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@types/yargs": "^17.0.35",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "mocha": "^12.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
